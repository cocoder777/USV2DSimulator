      "acceleration": 0.3,
      "angular_acceleration_deg": 0.0
    }
  },
  "communication": {
    "transport": "UDP",
    "protocol_version": 2,
    "encoding": "UTF-8",
    "framing": "每个数据报是一条完整 JSON；不使用换行分帧、不拆包、不拼包。",
    "unity_command_receiver": {
      "address": "127.0.0.1",
