  "model_notes": [
    "本模型为简化二维纵向运动和转向模型，未建模独立横向漂移速度、风浪、严格水动力学、推力或舵角。",
    "加速度指令先经过一阶滞后，再扣除速度阻尼后积分。零加速度指令不会保持恒速，也不会立即停车。",
    "净纵向加速度 = actual_acceleration - linearDamping * speed；净角加速度(deg/s^2) = actual_angular_acceleration_deg - angularDamping * yaw_rate_deg。速度达到限制时，实际积分结果还会受到限幅。",
    "固定物理步长是 0.02 s，状态默认约 0.1 s 一次；两者不是同一个频率。",
    "本文件参数为静态参考；Inspector 或参数面板修改后，需要同步更新文件或另行告知算法方，不应把旧参考值当作实时参数。"
  ],
  "state_fields": {
    "type": {
      "type": "string",
      "unit": null,
      "description": "消息类别。",
      "access": "udp_state",
      "constant": "state"
    },
    "version": {
      "type": "integer",
      "unit": null,
      "description": "UDP 协议版本；与路线 schema_version 无关。",
      "access": "udp_state",
      "constant": 2
    },
    "state_sequence": {
      "type": "integer",
      "unit": null,
      "description": "桥接组件实例内递增的状态序号；忽略重复及倒序状态。重启 Unity 后重新初始化接收端序号过滤。",
      "access": "udp_state",
      "csharp_type": "long"
    },
    "control_epoch": {
      "type": "string",
      "unit": null,
      "description": "当前控制周期标识；启动、运行变化和有效控制超时后更新。算法必须回传最新值。",
      "access": "udp_state"
    },
    "run_id": {
      "type": "string",
      "unit": null,
      "description": "运行编号；R 重置及模式切换时更新，控制消息必须回传最新值。",
      "access": "udp_state"
    },
    "mode": {
      "type": "string",
      "unit": null,
      "description": "控制来源；只有 External 执行外部指令。",
      "access": "udp_state",
      "allowed_values": [
        "Manual",
        "External"
      ]
    },
    "simulation_time": {
      "type": "number",
      "unit": "s",
      "description": "按固定步长累计的仿真时间；R 重置后归零，不是墙上时钟时间。",
      "access": "udp_state",
      "csharp_type": "double"
    },
    "x": {
      "type": "number",
      "unit": "m",
      "description": "艇中心的世界 X 坐标。",
      "access": "udp_state"
    },
    "y": {
      "type": "number",
      "unit": "m",
      "description": "艇中心的世界 Y 坐标。",
      "access": "udp_state"
    },
    "heading_deg": {
      "type": "number",
      "unit": "deg",
      "description": "航向，范围 [0, 360)；0 朝 +X，90 朝 +Y，逆时针为正。",
      "access": "udp_state"
    },
    "speed": {
      "type": "number",
      "unit": "m/s",
      "description": "沿船头方向的带符号线速度；正值前进、负值后退，不是世界 X 方向速度。",
      "access": "udp_state"
    },
    "yaw_rate_deg": {
      "type": "number",
      "unit": "deg/s",
      "description": "角速度；正值逆时针，负值顺时针。",
      "access": "udp_state"
    },
    "acceleration": {
      "type": "number",
      "unit": "m/s^2",
      "description": "当前已限幅的线加速度控制指令，尚未经过执行器滞后及速度阻尼。",
      "access": "udp_state"
    },
    "angular_acceleration_deg": {
      "type": "number",
      "unit": "deg/s^2",
      "description": "当前已限幅的角加速度控制指令，尚未经过执行器滞后及角速度阻尼。",
      "access": "udp_state"
    },
    "actual_acceleration": {
      "type": "number",
      "unit": "m/s^2",
      "description": "一阶滞后的线加速度执行器输出，尚未扣除 linearDamping * speed；不是净纵向加速度。",
      "access": "udp_state"
    },
    "actual_angular_acceleration_deg": {
      "type": "number",
      "unit": "deg/s^2",
      "description": "一阶滞后的角加速度执行器输出，尚未扣除 angularDamping * yaw_rate_deg；不是净角加速度。",
      "access": "udp_state"
    },
    "control_active": {
      "type": "boolean",
      "unit": null,
      "description": "仅在 UDP 监听正常、模式为 External 且最近有效指令未过期时为 true；不表示已经完成握手或路线跟踪。",
      "access": "udp_state"
    },
    "command_timed_out": {
      "type": "boolean",
      "unit": null,
      "description": "External 模式下无有效控制时为 true，包括尚未收到指令、指令超时或桥接不可用；Manual 下为 false。",
      "access": "udp_state"
    },
    "command_age_seconds": {
      "type": "number",
      "unit": "s",
      "description": "最近有效指令的单调实时时钟年龄；当前周期尚无有效指令时为 -1，周期重置后也恢复为 -1。",
      "access": "udp_state",
      "csharp_type": "double"
    }
  },
  "derived_fields": {
    "vx": {
      "type": "number",
      "unit": "m/s",
      "description": "世界 +X 方向的速度分量。",
      "access": "algorithm_derived",
      "formula": "speed * cos(heading_deg * pi / 180)",
      "inputs": [
        "speed",
        "heading_deg"
      ]
    },
    "vy": {
      "type": "number",
      "unit": "m/s",
      "description": "世界 +Y 方向的速度分量。",
      "access": "algorithm_derived",
      "formula": "speed * sin(heading_deg * pi / 180)",
      "inputs": [
        "speed",
        "heading_deg"
      ]
    }
  },
  "derived_notes": "公式使用弧度；vx/vy 是纵向 speed 在世界坐标下的投影，不是额外的传感器输出。模型没有独立船体系横向漂移速度状态。",
  "control_fields": {
    "type": {
      "type": "string",
      "unit": null,
      "description": "消息类别，固定为 control。",
      "access": "algorithm_output",
      "required": true,
      "constant": "control"
    },
    "version": {
      "type": "integer",
      "unit": null,
      "description": "协议版本，固定为 2。",
      "access": "algorithm_output",
      "required": true,
      "constant": 2
    },
    "run_id": {
      "type": "string",
      "unit": null,
      "description": "原样回传最新 UDP 状态的 run_id。",
      "access": "algorithm_output",
      "required": true
    },
    "control_epoch": {
      "type": "string",
      "unit": null,
      "description": "原样回传最新 UDP 状态的 control_epoch。",
      "access": "algorithm_output",
      "required": true
    },
    "sequence": {
      "type": "integer",
      "unit": null,
      "description": "当前 control_epoch 内严格递增的非负序号；新周期可从 0 或 1 开始。",
      "access": "algorithm_output",
      "required": true,
      "csharp_type": "long",
      "minimum": 0
    },
    "acceleration": {
      "type": "number",
      "unit": "m/s^2",
      "description": "算法给出的线加速度指令；正值向前加速，负值施加反向加速度，可减速并继续进入后退。不是目标速度。",
      "access": "algorithm_output",
      "required": true,
      "finite_required": true,
      "clamped_by": "maxAcceleration"
    },
    "angular_acceleration_deg": {
      "type": "number",
      "unit": "deg/s^2",
      "description": "算法给出的角加速度指令；正值逆时针，负值顺时针。不是目标角速度或舵角。",
      "access": "algorithm_output",
      "required": true,
      "finite_required": true,
      "clamped_by": "maxAngularAccelerationDeg"
    }
  },
  "control_example": {
    "purpose": "仅演示消息格式，不是路线跟踪策略；发送前替换运行标识和递增序号。",
    "message": {
      "type": "control",
      "version": 2,
      "run_id": "<最新状态中的run_id>",
      "control_epoch": "<最新状态中的control_epoch>",
