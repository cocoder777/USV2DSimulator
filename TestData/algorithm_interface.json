  "route_field_definitions": {
    "schema_version": {
      "type": "integer",
      "unit": null,
      "description": "路线文件版本，当前为 2；Unity 同时兼容版本 1 的任务点折线。与 UDP 协议版本独立。",
      "access": "file_route"
    },
    "route_id": {
      "type": "string",
      "unit": null,
      "description": "测试任务标识。",
      "access": "file_route"
    },
    "coordinate_system": {
      "type": "object",
      "unit": null,
      "description": "世界 XY、米、度、+X 为零航向及逆时针为正的坐标约定。",
      "access": "file_route"
    },
    "coordinate_system.frame": {
      "type": "string",
      "unit": null,
      "description": "unity_world_xy：Unity 世界 XY 平面。",
      "access": "file_route"
    },
    "coordinate_system.position_unit": {
      "type": "string",
      "unit": null,
      "description": "位置单位名称，固定为 m。",
      "access": "file_route"
    },
    "coordinate_system.unity_units_per_meter": {
      "type": "number",
      "unit": "Unity unit/m",
      "description": "每米对应的 Unity 单位数，当前为 1。",
      "access": "file_route"
    },
    "coordinate_system.heading_unit": {
      "type": "string",
      "unit": null,
      "description": "航向单位名称，固定为 deg。",
      "access": "file_route"
    },
    "coordinate_system.heading_zero_axis": {
      "type": "string",
      "unit": null,
      "description": "零航向所指坐标轴，固定为 +X。",
      "access": "file_route"
    },
    "coordinate_system.positive_rotation": {
      "type": "string",
      "unit": null,
      "description": "角度正方向，counterclockwise 表示逆时针。",
      "access": "file_route"
    },
    "initial_state": {
      "type": "object",
      "unit": null,
      "description": "测试约定初始状态，不会自动修改 Unity 初值。",
      "access": "file_route"
    },
    "initial_state.x": {
      "type": "number",
      "unit": "m",
      "description": "初始世界 X 坐标，与起点一致。",
      "access": "file_route"
    },
    "initial_state.y": {
      "type": "number",
      "unit": "m",
      "description": "初始世界 Y 坐标，与起点一致。",
      "access": "file_route"
    },
    "initial_state.heading_deg": {
      "type": "number",
      "unit": "deg",
      "description": "初始航向。",
      "access": "file_route"
    },
    "initial_state.speed": {
      "type": "number",
      "unit": "m/s",
      "description": "初始带符号纵向速度。",
      "access": "file_route"
    },
    "initial_state.yaw_rate_deg": {
      "type": "number",
      "unit": "deg/s",
      "description": "初始角速度。",
      "access": "file_route"
    },
    "cruise_speed_mps": {
      "type": "number",
      "unit": "m/s",
      "description": "建议巡航速度，可按转弯及停车需要降低。",
      "access": "file_route"
    },
    "arrival_radius_m": {
      "type": "number",
      "unit": "m",
      "description": "起点、打卡点及终点的到达半径，距离小于等于该值即进入范围。",
      "access": "file_route"
    },
    "stop_speed_mps": {
      "type": "number",
      "unit": "m/s",
      "description": "终点停车速度容差，比较 speed 的绝对值。",
      "access": "file_route"
    },
    "waypoints": {
      "type": "array<object>",
      "unit": null,
      "description": "有序任务点（起点、必过点、终点），只定义通过要求；版本 2 的参考路线以 path.samples 为准，不能直连任务点代替曲线。",
      "access": "file_route"
    },
    "waypoints[].id": {
      "type": "string",
      "unit": null,
      "description": "唯一点编号。",
      "access": "file_route"
    },
    "waypoints[].role": {
      "type": "string",
      "unit": null,
      "description": "start / checkpoint / end，分别表示起点、打卡点及终点。",
      "access": "file_route"
    },
    "waypoints[].x": {
      "type": "number",
      "unit": "m",
      "description": "点的世界 X 坐标。",
      "access": "file_route"
    },
    "waypoints[].y": {
      "type": "number",
      "unit": "m",
      "description": "点的世界 Y 坐标。",
      "access": "file_route"
    },
    "path": {
      "type": "object",
      "unit": null,
      "description": "版本 2 必填的采样曲线定义；Unity 和算法共用同一组 samples。",
      "access": "file_route"
    },
    "path.type": {
      "type": "string",
      "unit": null,
      "description": "固定为 sampled_curve。",
      "access": "file_route"
    },
    "path.interpolation": {
      "type": "string",
      "unit": null,
      "description": "piecewise_quintic_smoothstep：各任务点间使用五次平滑 y(x)，节点切线与曲率连续。",
      "access": "file_route"
    },
    "path.sampling_step_x_m": {
      "type": "number",
      "unit": "m",
      "description": "沿 X 轴的采样步长（不是等弧长），当前为 0.1；每段末尾保留精确任务点。",
      "access": "file_route"
    },
    "path.samples": {
      "type": "array<object>",
      "unit": null,
      "description": "按 X 严格递增排列的参考曲线采样点，当前共 401 个。算法应跟踪该数组，任务点仍独立用于通过判断。",
      "access": "file_route"
    },
    "path.samples[].x": {
      "type": "number",
      "unit": "m",
      "description": "参考曲线采样点的世界 X 坐标。",
      "access": "file_route"
    },
    "path.samples[].y": {
      "type": "number",
      "unit": "m",
      "description": "参考曲线采样点的世界 Y 坐标。",
      "access": "file_route"
    }
  },
  "route_task_rules": {
    "pass_order": [
      "S",
      "P1",
      "P2",
      "P3",
      "E"
    ],
    "reference_geometry": "以 route.path.samples 为参考曲线，依次经过 waypoints 中的五个任务点；不再直连任务点生成折线。相邻采样点是平滑曲线的细分近似。",
    "checkpoint_condition": "艇中心至当前待通过点的欧氏距离 <= route.arrival_radius_m；只按顺序累计，不能提前计入后续点。",
    "stop_at_intermediate_points": false,
    "completion_condition": "已依次通过全部中间打卡点，且同一时刻满足到终点距离 <= route.arrival_radius_m 和 abs(speed) <= route.stop_speed_mps。",
    "terminal_heading_required": false,
    "terminal_dwell_required": false,
    "implemented_by_unity": "目前 Unity 只显示路线，不执行上述打卡统计、任务完成判断或自动跟踪。"
  },
