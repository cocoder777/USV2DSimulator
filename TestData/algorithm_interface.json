  "route_generation": {
    "script": "TestData/generate_fixed_curve.py",
    "input": "TestData/fixed_route.json 的 waypoints；initial_state、巡航速度和容差保留。",
    "formula": "t=(x-x0)/(x1-x0); y=y0+(y1-y0)*(10*t^3-15*t^4+6*t^5)",
